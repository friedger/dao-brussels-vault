{
  "name": "dao-brussels-vault-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "fuzz:invariant": "rv . bxl-vault-v2-rv invariant --config rendezvous/rv.config.json",
    "fuzz:test": "rv . bxl-vault-v2-rv test --config rendezvous/rv.config.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^4.0.0",
    "@stacks/rendezvous": "^1.1.0",
    "@stacks/transactions": "^7.7.0",
    "@types/node": "^26.6.6",
    "chokidar-cli": "^3.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-environment-clarinet": "^4.0.0"
  }
}
